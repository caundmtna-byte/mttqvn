# Copy to .env.local and fill values (never commit .env.local).
# Supabase → Project Settings → API

# --- Bắt buộc ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Tuỳ chọn ---
# Cloudinary — upload ảnh (unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Sentry — theo dõi lỗi ở môi trường chạy thật.
# Bỏ trống thì toàn bộ phần giám sát tự tắt, ứng dụng chạy bình thường.
# VITE_SENTRY_DSN=
# Tỉ lệ lấy mẫu hiệu năng (0..1). Bỏ trống = 0.1 (10%).
# VITE_SENTRY_TRACES_SAMPLE_RATE=
# Phiên bản phát hành — thiếu thì stack trace ở production là mã đã nén, đọc không ra.
# VITE_APP_VERSION=

# --- Bảo mật ---
# - Anon key có thể lộ trong bundle SPA; bảo vệ dữ liệu bằng RLS trên Supabase.
# - KHÔNG đặt SUPABASE_SERVICE_ROLE_KEY vào biến VITE_* (chỉ dùng server/scripts/Edge Functions).
