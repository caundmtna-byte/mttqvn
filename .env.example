# Copy to .env.local and fill from Supabase → Project Settings → API
# Khi cả hai dòng dưới có giá trị (không rỗng), app dùng Supabase (auth + repository).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tuỳ chọn: ép dùng mock toàn app dù đã điền URL/key (ví dụ khi dev).
# VITE_FORCE_MOCK=true

# Cloudinary — upload logo Thông tin tổ chức (unsigned preset, folder mttqvn/branding)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Deprecated: VITE_DATA_SOURCE=mock vẫn được hỗ trợ để ép mock (tương thích .env cũ).
