# Copy to .env.local and fill values (never commit .env.local).
# Supabase → Project Settings → API

# --- Bắt buộc ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Tuỳ chọn ---
# Cloudinary — upload ảnh (unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Sentry (production error tracking)
# VITE_SENTRY_DSN=

# --- Bảo mật ---
# - Anon key có thể lộ trong bundle SPA; bảo vệ dữ liệu bằng RLS trên Supabase.
# - KHÔNG đặt SUPABASE_SERVICE_ROLE_KEY vào biến VITE_* (chỉ dùng server/scripts/Edge Functions).
